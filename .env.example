# ==============================================================================
# FreeDocForge.com - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit your actual .env file or real credentials to Git!

# MySQL Database Connection (via Prisma)
# Replace with your cPanel / Laragon / Cloud MySQL credentials
DATABASE_URL="mysql://root:@localhost:3306/freedocforge_db"

# JWT Secret for Session Authentication (generate a secure random 32+ char string)
JWT_SECRET="replace-with-a-secure-random-32-char-string-in-production"

# Application URL
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-secure-random-32-char-string-in-production"

# Google OAuth 2.0 Credentials (Google Cloud Console > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin Provisioning Key (Required for registering admin accounts)
ADMIN_PROVISION_KEY="set-a-strong-secret-key-for-admin-provisioning"

# Google AdSense Monetization Toggle
# Set to "false" to hide all ad blocks during review.
# Set to "true" and fill your ca-pub ID after receiving AdSense approval.
NEXT_PUBLIC_ENABLE_ADS="false"
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""

# Optional: AI Assistant Key (e.g. Gemini / OpenAI)
AI_API_KEY=""
